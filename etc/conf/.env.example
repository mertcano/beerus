# Starknet RPC URL, e.g. infura or pathfinder
STARKNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/<YOUR API KEY>

# Starknet Feeder Gateway base URL (OPTIONAL)
GATEWAY_URL=https://alpha-mainnet.starknet.io

# Path to data directory for node data (OPTIONAL)
DATA_DIR=tmp

# Poll interval seconds (OPTIONAL)
POLL_SECS=30

# Address the JSON-RPC server binds to (OPTIONAL, default 127.0.0.1:3030)
#
# The server has no authentication and its `starknet_call` / `starknet_getStorageAt` methods
# execute Cairo, so exposing it on a public interface makes the node a network-reachable
# denial-of-service target. Keep the loopback default and put authentication in front of it
# (reverse proxy / SSH tunnel) if remote access is required. Set to 0.0.0.0 only deliberately.
RPC_ADDR=127.0.0.1:3030
